+const llama_memory_hybrid_idx_context::qsa_plan & llama_memory_hybrid_idx_context::get_qsa_plan(uint32_t ratio, bool blk_bias) const {
+    if (qsa_plans_ubatch != i_cur) {
+        qsa_plans.clear();
+        qsa_plans_ubatch = i_cur;
+    }
+
+    auto it = qsa_plans.find(ratio);
+    if (it != qsa_plans.end()) {
+        return it->second;
+    }
+
+    qsa_plan & p = qsa_plans[ratio];
+
+    const auto * idx = get_idx();
+
+    // the fast path: one stream with one sequence, unique positions, the per-block bias
+    if (!is_batch || !mem || !idx || mem->qsa_pool_ratio != ratio || mem->qsa_valid.size() != 1 ||
+        !blk_bias || get_n_stream() != 1 || llama_qsa_pooled_paused()) {
+        return p;
+    }
+
+    const llama_ubatch & ub = get_ubatch();
+    if (ub.n_tokens == 0 || ub.n_seq_id[0] != 1) {
+        return p;
+    }
+
+    const llama_seq_id seq = ub.seq_id[0][0];
+    for (uint32_t i = 1; i < ub.n_tokens; ++i) {
+        if (ub.n_seq_id[i] != 1 || ub.seq_id[i][0] != seq) {
+            return p;
+        }
+    }
+
+    const auto & cells = mem->get_mem_idx()->get_cells(seq);
+
+    int n_seq_present = 0;
+    for (int sq = 0; sq < LLAMA_MAX_SEQ && n_seq_present < 2; ++sq) {
+        if (cells.seq_pos_min(sq) >= 0) {
+            n_seq_present++;
+        }
+    }
+    if (n_seq_present > 1) {
+        return p;
+    }
+
+    const int64_t r        = ratio;
+    const int64_t n_kv     = idx->get_n_kv();
+    const int64_t n_blocks = (n_kv + r - 1)/r;
+
+    p.cell_blk.assign(n_kv, 0);
+    p.seen    .assign(n_blocks, 0);
+    p.member  .assign(r*n_blocks, 0);
+    p.dirty   .clear();
+
+    for (int64_t j = 0; j < n_kv; ++j) {
+        if (cells.is_empty(j)) {
+            continue;
+        }
+
+        const llama_pos pos = cells.pos_get(j);
+        const int64_t   b   = pos/r;
+        const int64_t   k   = pos%r;
+
+        // past the window, or a position cached twice (mrope images): not a plain position line
+        if (pos < 0 || b >= n_blocks || (p.seen[b] >> k) & 1) {
+            p.cell_blk.clear();
+            return p;
+        }
+
+        p.seen[b]         |= (uint8_t) (1u << k);
+        p.member[b*r + k]  = (int32_t) j;
+        p.cell_blk[j]      = (int32_t) b;
+    }
+
+    const uint8_t full = (uint8_t) ((1u << r) - 1);
+
+    const int32_t stream = (int32_t) mem->get_mem_idx()->get_stream_of(seq);
+
+    for (int64_t b = std::max<int64_t>(mem->qsa_valid[stream], 0); b < n_blocks; ++b) {
+        if (p.seen[b] == full) {
+            p.dirty.push_back((int32_t) b);
+        }
+    }
+
+    // a fixed size for steady decode keeps the graph reusable; a catch-up after a restore grows it
+    const int64_t n      = (int64_t) p.dirty.size();
+    const int64_t d_base = ((int64_t) ub.n_tokens + r - 1)/r + 1;
+
+    int64_t d = d_base;
+    if (n > d_base) {
+        d = 1;
+        while (d < n) {
+            d *= 2;
+        }
+        d = std::max(n, std::min(d, n_blocks));
+    }
+
+    p.n_dirty = d;
+    p.stream  = stream;
+    p.fast    = true;
+
+    return p;
+}
+
+void llama_memory_hybrid_idx_context::set_input_qsa_fast(
+        ggml_tensor * cell_blk,
+        ggml_tensor * bias,
+        ggml_tensor * dirty_cells,
+        ggml_tensor * dirty_rows,
+        ggml_tensor * dirty_pos,
+        const llama_ubatch * ubatch,
+        uint32_t ratio) const {
+    const qsa_plan & p = get_qsa_plan(ratio, true);
+    GGML_ASSERT(p.fast && "qsa: the graph was built for the pooled path but the ubatch cannot take it");
+
+    const int64_t r        = ratio;
+    const int64_t n_kv     = cell_blk->ne[0];
+    const int64_t n_blocks = bias->ne[0];
+    const int64_t n_tps    = bias->ne[1];
+    const int64_t d        = dirty_rows->ne[0];
+    const int64_t n        = (int64_t) p.dirty.size();
+    const int64_t rows     = mem->qsa_pool_rows;
+
+    GGML_ASSERT(d == p.n_dirty && n <= d);
+    GGML_ASSERT((int64_t) p.cell_blk.size() == n_kv && (int64_t) p.seen.size() == n_blocks);
+    GGML_ASSERT(n_tps == (int64_t) ubatch->n_tokens);
+    GGML_ASSERT(ggml_backend_buffer_is_host(cell_blk->buffer));
+
+    memcpy(cell_blk->data, p.cell_blk.data(), n_kv*sizeof(int32_t));
+
+    int32_t * dst_cells = (int32_t *) dirty_cells->data;
+    int64_t * dst_rows  = (int64_t *) dirty_rows->data;
+    int32_t * dst_pos   = (int32_t *) dirty_pos->data;
+
+    for (int64_t i = 0; i < d; ++i) {
+        const int64_t b = i < n ? p.dirty[i] : -1;
+
+        for (int64_t k = 0; k < r; ++k) {
+            dst_cells[i*r + k] = b >= 0 ? p.member[b*r + k] : 0;
+        }
+
+        // padding lands on the spare last row, which no block owns
+        dst_rows[i] = p.stream*rows + (b >= 0 ? b : rows - 1);
+
+        // same rope position as the full path: the block's first position, in all 4 sections
+        for (int64_t sec = 0; sec < 4; ++sec) {
+            dst_pos[sec*d + i] = b >= 0 ? (int32_t) (b*r) : 0;
+        }
+    }
+
+    // as the full path's per-block bias, with blocks named by position instead of by rank:
+    // complete blocks score (plus 1e9 from the query's tail on), incomplete ones are always
+    // visible like the full path's spare block, empty ones are never picked
+    const uint8_t full = (uint8_t) ((1u << r) - 1);
+
+    float * dst_bias = (float *) bias->data;
+
+    for (int64_t i = 0; i < n_tps; ++i) {
+        const int64_t q          = ubatch->pos[i];
+        const int64_t tail_start = (q + 1)/r*r;
+
+        float * cur = dst_bias + i*n_blocks;
+
+        for (int64_t b = 0; b < n_blocks; ++b) {
+            const uint8_t s = p.seen[b];
+            cur[b] = s == full ? (b*r >= tail_start ? 1e9f : 0.0f) : (s != 0 ? 1e9f : -INFINITY);
+        }
+    }
+}
