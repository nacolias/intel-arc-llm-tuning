+// LLAMA_HOST_PROF (see llama-graph.cpp): phase times of process_ubatch per context type and size
+extern std::map<std::string, std::pair<double, int64_t>> g_llama_host_prof_inputs;
+int llama_host_prof_interval();
+
+static std::map<std::string, std::pair<double, int64_t>> g_llama_host_prof_phases;
+
+static void llama_host_prof_add(const std::string & key, int64_t t0_us) {
+    auto & e = g_llama_host_prof_phases[key];
+    e.first  += (ggml_time_us() - t0_us)/1000.0;
+    e.second += 1;
+}
+
+static void llama_host_prof_tick() {
+    static int64_t last = ggml_time_us();
+    const int64_t now = ggml_time_us();
+    if (now - last < (int64_t) llama_host_prof_interval()*1000000) {
+        return;
+    }
+    last = now;
+    for (auto * m : { &g_llama_host_prof_phases, &g_llama_host_prof_inputs }) {
+        for (const auto & kv : *m) {
+            LLAMA_LOG_WARN("[HOST-PROF] %9.1f ms %8lld  %.3f ms avg  %s\n", kv.second.first, (long long) kv.second.second,
+                           kv.second.first/std::max<int64_t>(kv.second.second, 1), kv.first.c_str());
+        }
+        m->clear();
+    }
+}
+
 llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret) {
+    const bool hprof = llama_host_prof_interval() > 0;
+    const std::string hkey = std::string(cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP ? "draft" : "target") +
+        (ubatch.n_tokens == 1 ? " t=1" : ubatch.n_tokens <= 8 ? " t<=8" : " t>8");
+    int64_t ht = hprof ? ggml_time_us() : 0;
+
     if (mctx && !mctx->apply()) {
         LLAMA_LOG_ERROR("%s: failed to apply memory context\n", __func__);
         ret = GGML_STATUS_FAILED;
         return nullptr;
     }
 
+    if (hprof) { llama_host_prof_add(hkey + " apply", ht); ht = ggml_time_us(); }
+
     auto * res = get_gf_res_prev();
     auto * gf  = res->get_gf();
 
@@ -1398,12 +1433,18 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         //const auto t_start_us = ggml_time_us();
 
         // FIXME this call causes a crash if any model inputs were not used in the graph and were therefore not allocated
+        if (hprof) { llama_host_prof_add(hkey + " build/reuse", ht); ht = ggml_time_us(); }
+
         res->set_inputs(&ubatch);
 
+        if (hprof) { llama_host_prof_add(hkey + " set_inputs", ht); ht = ggml_time_us(); }
+
         //LLAMA_LOG_INFO("graph set inputs time: %.3f ms\n", (ggml_time_us() - t_start_us)/1000.0);
     }
 
     const auto status = graph_compute(res->get_gf(), ubatch.n_tokens > 1);
+
+    if (hprof) { llama_host_prof_add(hkey + " compute", ht); llama_host_prof_tick(); }
     if (status != GGML_STATUS_SUCCESS) {
         LLAMA_LOG_ERROR("%s: failed to compute graph, compute status: %d\n", __func__, status);
         ret = status;
