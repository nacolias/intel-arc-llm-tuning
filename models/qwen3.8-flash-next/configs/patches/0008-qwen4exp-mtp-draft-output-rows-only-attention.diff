@@ -1353,9 +1357,28 @@ void llm_graph_result::reset() {
     gf = ggml_new_graph_custom(ctx_compute.get(), max_nodes, false);
 }
 
+// LLAMA_HOST_PROF=<seconds>: host time per graph input type, accumulated here and printed by
+// llama_host_prof_tick() (llama-context.cpp) together with the process_ubatch phase times
+std::map<std::string, std::pair<double, int64_t>> g_llama_host_prof_inputs;
+
+int llama_host_prof_interval() {
+    static const int s = [] {
+        const char * e = getenv("LLAMA_HOST_PROF");
+        return e != nullptr ? std::max(0, atoi(e)) : 0;
+    }();
+    return s;
+}
+
 void llm_graph_result::set_inputs(const llama_ubatch * ubatch) {
+    const bool prof = llama_host_prof_interval() > 0;
     for (auto & input : inputs) {
+        const int64_t t0 = prof ? ggml_time_us() : 0;
         input->set_input(ubatch);
+        if (prof) {
+            auto & e = g_llama_host_prof_inputs[typeid(*input).name()];
+            e.first  += (ggml_time_us() - t0)/1000.0;
+            e.second += 1;
+        }
     }
 }
 
