+// Host->device copy staged through two reusable pinned buffers per device: the host memcpy of one
+// chunk overlaps the device copy of the other. Replaces a fresh malloc per call, which page-faulted
+// on every page (about 0.5 s per GiB) before the copy could start.
+static void ggml_sycl_staged_h2d(int device, sycl::queue & q, char * dst, const char * src, size_t size) {
+    static constexpr size_t chunk = 32ull << 20;
+    static std::mutex mtx[GGML_SYCL_MAX_DEVICES];
+    static char * bufs[GGML_SYCL_MAX_DEVICES][2] = {};
+    std::lock_guard<std::mutex> lock(mtx[device]);
+    if (bufs[device][0] == nullptr) {
+        for (auto & b : bufs[device]) {
+            b = (char *) sycl::malloc_host(chunk, q);
+        }
+        if (bufs[device][0] == nullptr || bufs[device][1] == nullptr) {
+            // no pinned memory: copy through one plain buffer, as before
+            char * host_buf = (char *) malloc(size);
+            memcpy(host_buf, src, size);
+            q.memcpy(dst, host_buf, size).wait();
+            free(host_buf);
+            for (auto & b : bufs[device]) {
+                if (b) { sycl::free(b, q); b = nullptr; }
+            }
+            return;
+        }
+    }
+    sycl::event ev[2];
+    int b = 0;
+    for (size_t off = 0; off < size; off += chunk, b ^= 1) {
+        const size_t n = std::min(chunk, size - off);
+        ev[b].wait();   // this buffer's previous chunk has reached the device
+        memcpy(bufs[device][b], src + off, n);
+        ev[b] = q.memcpy(dst + off, bufs[device][b], n);
+    }
+    ev[0].wait();
+    ev[1].wait();
+}
