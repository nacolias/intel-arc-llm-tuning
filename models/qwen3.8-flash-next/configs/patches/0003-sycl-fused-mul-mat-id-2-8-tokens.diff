diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index 2bc9e59e4..8599cab7f 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -104,6 +104,9 @@ int g_ggml_sycl_enable_vmm = 1;
 int g_ggml_sycl_enable_fusion = 1;
 int g_ggml_sycl_enable_esimd = 1;
 int g_ggml_sycl_prioritize_dmmv = 0;
+// Small multi-token MUL_MAT_ID batches (MTP verify, short prompts) run the fused single-token
+// MMVQ path once per token instead of the host-synchronised per-expert loop.
+int g_ggml_sycl_mmid_multitoken = 1;
 int g_ggml_sycl_use_async_mem_op = 0;
 int g_ggml_sycl_use_async_mem_op_requested = 1;
 int g_ggml_sycl_use_level_zero_api = 0;
@@ -358,6 +361,8 @@ static void ggml_check_sycl() try {
         g_ggml_sycl_enable_fusion = ggml_sycl_get_env("GGML_SYCL_ENABLE_FUSION", 1);
         g_ggml_sycl_enable_esimd = ggml_sycl_get_env("GGML_SYCL_ENABLE_ESIMD", 1);
         g_ggml_sycl_prioritize_dmmv = ggml_sycl_get_env("GGML_SYCL_PRIORITIZE_DMMV", 0);
+        g_ggml_sycl_mmid_multitoken =
+            ggml_sycl_get_env("GGML_SYCL_MMID_MULTITOKEN", 1);
 
 #ifdef GGML_SYCL_SUPPORT_LEVEL_ZERO_API
         g_ggml_sycl_use_level_zero_api = ggml_sycl_get_env("GGML_SYCL_USE_LEVEL_ZERO_API", 1);
@@ -477,6 +482,7 @@ static void ggml_check_sycl() try {
 #endif
 
         GGML_LOG_INFO("  GGML_SYCL_PRIORITIZE_DMMV: %d\n", g_ggml_sycl_prioritize_dmmv);
+        GGML_LOG_INFO("  GGML_SYCL_MMID_MULTITOKEN: %d\n", g_ggml_sycl_mmid_multitoken);
 
         g_ggml_sycl_use_async_mem_op_requested = ggml_sycl_get_env("GGML_SYCL_USE_ASYNC_MEM_OP", 1);
         GGML_LOG_INFO("  GGML_SYCL_USE_ASYNC_MEM_OP: %d\n", g_ggml_sycl_use_async_mem_op_requested);
@@ -5197,6 +5203,44 @@ static void ggml_sycl_mul_mat_id(ggml_backend_sycl_context & ctx,
         if (ggml_sycl_mul_mat_id_mmvq_fused(ctx, src0, src1, ids, dst)) {
             return;
         }
+    } else if (g_ggml_sycl_mmid_multitoken && ne12 <= MMVQ_MAX_BATCH_SIZE && ids->ne[1] == ne12 &&
+               ids->nb[0] == sizeof(int32_t) && ne13 == 1 && ids->ne[2] == 1) {
+        // Small batches (MTP verify passes of 2-4 tokens, short prompts): run the fused
+        // single-token path on a per-token view. The per-expert loop below copies ids to the
+        // host and waits on the stream first, then launches one matmul per distinct expert:
+        // on a 4x B70 host that made a 4-token verify cost ~2.5x a single-token pass.
+        // The checks inside the fused path depend only on types and shapes that are the same
+        // for every token, so either token 0 is refused (nothing written, fall through) or all
+        // tokens are handled.
+        bool handled = true;
+        for (int64_t t = 0; t < ne12; t++) {
+            ggml_tensor src1_t = *src1;
+            src1_t.ne[2] = 1;
+            src1_t.ne[3] = 1;
+            src1_t.nb[3] = src1_t.nb[2];
+            src1_t.data  = (char *) src1->data + t*nb12;
+
+            ggml_tensor ids_t = *ids;
+            ids_t.ne[1] = 1;
+            ids_t.nb[2] = ids_t.nb[1];
+            ids_t.nb[3] = ids_t.nb[1];
+            ids_t.data  = (char *) ids->data + t*ids->nb[1];
+
+            ggml_tensor dst_t = *dst;
+            dst_t.ne[2] = 1;
+            dst_t.ne[3] = 1;
+            dst_t.nb[3] = dst_t.nb[2];
+            dst_t.data  = (char *) dst->data + t*nb2;
+
+            if (!ggml_sycl_mul_mat_id_mmvq_fused(ctx, src0, &src1_t, &ids_t, &dst_t)) {
+                GGML_ASSERT(t == 0 && "fused MUL_MAT_ID refused a later token of the same op");
+                handled = false;
+                break;
+            }
+        }
+        if (handled) {
+            return;
+        }
     }
 
     std::vector<char> ids_host(ggml_nbytes(ids));
