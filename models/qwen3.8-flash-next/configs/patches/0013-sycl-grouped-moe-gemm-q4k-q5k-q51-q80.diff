+// 6-bit scale and min j of a q4_K/q5_K superblock (get_scale_min_k4)
+static __dpct_inline__ void fg_scale_min_k4(const int j, const uint8_t * __restrict__ q, int & d, int & m) {
+    if (j < 4) {
+        d = q[j] & 63;
+        m = q[j + 4] & 63;
+    } else {
+        d = (q[j + 4] & 0xf) | ((q[j - 4] >> 6) << 4);
+        m = (q[j + 4] >> 4)  | ((q[j]     >> 6) << 4);
+    }
+}
+
+// q4_K/q5_K: k step ib of a superblock is the low (even ib) or high (odd ib) nibbles of qs bytes
+// 32*(ib/2).., with its own scale and min; q5_K adds bit ib of qh[j] as 16. Same values as
+// dequantize_block_q4_K / _q5_K.
+template <bool has_qh>
+static __dpct_inline__ void fg_stage_kq(const uint8_t * __restrict__ qs, const uint8_t * __restrict__ qh,
+                                        const uint8_t * __restrict__ scales, const sycl::half2 dm, const int ib,
+                                        sycl::half2 * a) {
+    int sc, m;
+    fg_scale_min_k4(ib, scales, sc, m);
+    const float     d     = (float) dm[0] * sc;
+    const float     mn    = (float) dm[1] * m;
+    const uint8_t * q     = qs + 32 * (ib / 2);
+    const int       shift = 4 * (ib % 2);
+#pragma unroll
+    for (int j = 0; j < 16; ++j) {
+        int v0 = (q[2 * j]     >> shift) & 0xf;
+        int v1 = (q[2 * j + 1] >> shift) & 0xf;
+        if constexpr (has_qh) {
+            v0 |= ((qh[2 * j]     >> ib) & 1) << 4;
+            v1 |= ((qh[2 * j + 1] >> ib) & 1) << 4;
+        }
+        a[j] = sycl::half2((sycl::half) (d * v0 - mn), (sycl::half) (d * v1 - mn));
+    }
+}
+
+static __dpct_inline__ void fg_stage_a(const block_q4_K * __restrict__ xrow, const int kb, sycl::half2 * a) {
+    FG_SUPERBLOCK(block_q4_K);
+    fg_stage_kq<false>(blk->qs, nullptr, blk->scales, blk->dm, ib, a);
+}
+
+static __dpct_inline__ void fg_stage_a(const block_q5_K * __restrict__ xrow, const int kb, sycl::half2 * a) {
+    FG_SUPERBLOCK(block_q5_K);
+    fg_stage_kq<true>(blk->qs, blk->qh, blk->scales, blk->dm, ib, a);
+}
+
+// q5_1 and q8_0 blocks are one k step each. q5_1: value j is the low nibble of qs[j] plus bit j of
+// qh, value j + 16 the high nibble plus bit j + 16 (dequantize_q5_1).
+static __dpct_inline__ void fg_stage_a(const block_q5_1 * __restrict__ xrow, const int kb, sycl::half2 * a) {
+    const block_q5_1 * blk = xrow + kb;
+    const float        d   = blk->dm[0];
+    const float        mn  = blk->dm[1];
+    uint32_t           qh;
+    memcpy(&qh, blk->qh, sizeof(qh));
+#pragma unroll
+    for (int j = 0; j < QK5_1 / 2; j += 2) {
+        const int x0 = (blk->qs[j]     & 0xf) | (((qh >> (j + 0)) << 4) & 0x10);
+        const int x1 = (blk->qs[j + 1] & 0xf) | (((qh >> (j + 1)) << 4) & 0x10);
+        const int y0 = (blk->qs[j]     >> 4)  | ((qh >> (j + 12)) & 0x10);
+        const int y1 = (blk->qs[j + 1] >> 4)  | ((qh >> (j + 13)) & 0x10);
+        a[j / 2]     = sycl::half2((sycl::half) (x0 * d + mn), (sycl::half) (x1 * d + mn));
+        a[j / 2 + 8] = sycl::half2((sycl::half) (y0 * d + mn), (sycl::half) (y1 * d + mn));
+    }
+}
+
+static __dpct_inline__ void fg_stage_a(const block_q8_0 * __restrict__ xrow, const int kb, sycl::half2 * a) {
+    const block_q8_0 * blk = xrow + kb;
+    const float        d   = blk->d;
+#pragma unroll
+    for (int j = 0; j < QK8_0 / 2; ++j) {
+        a[j] = sycl::half2((sycl::half) (d * blk->qs[2 * j]), (sycl::half) (d * blk->qs[2 * j + 1]));
+    }
+}
+
+template <> struct fg_block_traits<block_q4_K> { static constexpr int qk = QK_K; };
+template <> struct fg_block_traits<block_q5_K> { static constexpr int qk = QK_K; };
+template <> struct fg_block_traits<block_q5_1> { static constexpr int qk = QK5_1; };
+template <> struct fg_block_traits<block_q8_0> { static constexpr int qk = QK8_0; };
+
+// A row of the weights as the tile reads it: row `row` of an M x K matrix stored at x. Stored
+// blocks by default; the SoA tags below cover the per-expert layouts of reorder_qw_q*_k_moe.
+template <typename block_q_t> struct fg_row {
+    const block_q_t * x;
+
+    fg_row(const void * base, const int row, const int /* M */, const int K) :
+        x((const block_q_t *) base + (size_t) row * (K / fg_block_traits<block_q_t>::qk)) {}
+
+    void stage(const int kb, sycl::half2 * a) const { fg_stage_a(x, kb, a); }
+};
+
+// [qs][qh (q5_K only)][scales][dm] over the nb = M*K/QK_K blocks of the matrix
+struct fg_q4_K_soa {};
+struct fg_q5_K_soa {};
+
+template <bool has_qh> struct fg_row_kq_soa {
+    static constexpr size_t qh_bytes = has_qh ? QK_K / 8 : 0;
+
+    const uint8_t * base;
+    size_t          nb;
+    size_t          blk0;
+
+    fg_row_kq_soa(const void * x, const int row, const int M, const int K) :
+        base((const uint8_t *) x), nb((size_t) M * (K / QK_K)), blk0((size_t) row * (K / QK_K)) {}
+
+    void stage(const int kb, sycl::half2 * a) const {
+        const size_t      g  = blk0 + kb / (QK_K / 32);
+        const uint8_t *   qs = base + g * (QK_K / 2);
+        const uint8_t *   qh = base + nb * (QK_K / 2) + g * qh_bytes;
+        const uint8_t *   sc = base + nb * (QK_K / 2 + qh_bytes) + g * K_SCALE_SIZE;
+        const sycl::half2 dm = *(const sycl::half2 *) (base + nb * (QK_K / 2 + qh_bytes + K_SCALE_SIZE) +
+                                                       g * sizeof(sycl::half2));
+        fg_stage_kq<has_qh>(qs, qh, sc, dm, kb % (QK_K / 32), a);
+    }
+};
+
+template <> struct fg_row<fg_q4_K_soa> : fg_row_kq_soa<false> { using fg_row_kq_soa<false>::fg_row_kq_soa; };
+template <> struct fg_row<fg_q5_K_soa> : fg_row_kq_soa<true>  { using fg_row_kq_soa<true>::fg_row_kq_soa; };
