+// dst row (t, h, slot) lives at ((t*n_head + h)*n_kv_g + slot)*row_size: sequence t, head h.
+static void sparse_fa_gather_rows_multi(sycl::queue * stream,
+                                        const uint8_t * __restrict__ src,
+                                        uint8_t * __restrict__ dst,
+                                        const int32_t * __restrict__ indices,
+                                        const int32_t * __restrict__ count,
+                                        const size_t row_size,
+                                        const size_t src_nb1,
+                                        const size_t src_nb2,
+                                        const int64_t n_kv_g,
+                                        const int64_t n_head,
+                                        const int64_t n_rows) {
+    GGML_ASSERT(row_size % sizeof(uint32_t) == 0);
+    const size_t words = row_size / sizeof(uint32_t);
+
+    stream->parallel_for(
+        sycl::range<3>((size_t) (n_rows * n_head), (size_t) n_kv_g, words),
+        [=](sycl::id<3> id) {
+            const int64_t th   = (int64_t) id[0];
+            const int64_t t    = th / n_head;
+            const int64_t h    = th - t * n_head;
+            const int64_t slot = (int64_t) id[1];
+            const size_t  w    = id[2];
+
+            uint32_t * dst_row = (uint32_t *) (dst + ((size_t) (th * n_kv_g + slot)) * row_size);
+
+            if (slot >= (int64_t) count[t]) {
+                dst_row[w] = 0;
+                return;
+            }
+
+            const uint32_t * src_row =
+                (const uint32_t *) (src + (size_t) indices[t * n_kv_g + slot] * src_nb1 + (size_t) h * src_nb2);
+            dst_row[w] = src_row[w];
+        });
+}
+
+static void sparse_fa_gather_mask_multi(sycl::queue * stream,
+                                        const sycl::half * __restrict__ mask,
+                                        sycl::half * __restrict__ mask_g,
+                                        const int32_t * __restrict__ indices,
+                                        const int32_t * __restrict__ count,
+                                        const int64_t n_kv_g,
+                                        const int64_t n_rows,
+                                        const size_t mask_s1) {
+    stream->parallel_for(
+        sycl::range<2>((size_t) n_rows, (size_t) n_kv_g),
+        [=](sycl::id<2> id) {
+            const int64_t t    = (int64_t) id[0];
+            const int64_t slot = (int64_t) id[1];
+
+            sycl::half v = sycl::half(-INFINITY);
+            if (slot < (int64_t) count[t]) {
+                v = mask[(size_t) t * mask_s1 + (size_t) indices[t * n_kv_g + slot]];
+            }
+            mask_g[(size_t) t * n_kv_g + slot] = v;
+        });
+}
