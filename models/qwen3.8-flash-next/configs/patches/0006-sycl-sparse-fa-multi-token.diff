+// Multi-row variants: row t of the mask owns indices[t*n_kv_g ...] and count[t].
+static void sparse_fa_compact_mask_rows(sycl::queue * stream,
+                                        const sycl::half * __restrict__ mask,
+                                        int32_t * __restrict__ indices,
+                                        int32_t * __restrict__ count,
+                                        const int64_t n_kv,
+                                        const int64_t n_kv_g,
+                                        const int64_t n_rows,
+                                        const size_t mask_s1) {
+    constexpr size_t WG = 256;
+    const size_t global = (size_t) GGML_PAD(n_kv, (int64_t) WG);
+
+    stream->parallel_for(
+        sycl::nd_range<2>(sycl::range<2>((size_t) n_rows, global), sycl::range<2>(1, WG)),
+        [=](sycl::nd_item<2> item) {
+            const int64_t t = (int64_t) item.get_global_id(0);
+            const int64_t i = (int64_t) item.get_global_id(1);
+            if (i >= n_kv || !sycl::isfinite((float) mask[(size_t) t * mask_s1 + i])) {
+                return;
+            }
+
+            sycl::atomic_ref<int32_t,
+                             sycl::memory_order::relaxed,
+                             sycl::memory_scope::device,
+                             sycl::access::address_space::global_space> ctr(count[t]);
+
+            const int32_t pos = ctr.fetch_add(1);
+            if (pos < (int32_t) n_kv_g) {
+                indices[t * n_kv_g + pos] = (int32_t) i;
+            }
+        });
+}
