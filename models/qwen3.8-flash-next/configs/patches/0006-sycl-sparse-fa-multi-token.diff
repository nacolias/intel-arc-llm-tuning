+// Several query rows, each with its own selection: row t becomes sequence t (ne[3] = T) with its
+// own gathered K/V/mask, so the dense kernels run unchanged. Q and dst need no copy: Q's token
+// stride becomes its sequence stride, and dst [D, H, T, 1] has the same layout as [D, H, 1, T].
+static void ggml_sycl_flash_attn_ext_sparse_multi(ggml_backend_sycl_context & ctx, ggml_tensor * dst,
+                                                  const int64_t n_kv_g) {
+    ggml_tensor * Q    = dst->src[0];
+    ggml_tensor * K    = dst->src[1];
+    ggml_tensor * V    = dst->src[2];
+    ggml_tensor * mask = dst->src[3];
+
+    const int64_t n_q      = Q->ne[1];
+    const int64_t n_kv     = K->ne[1];
+    const int64_t n_head_k = K->ne[2];
+    const size_t  mask_s1  = mask->nb[1] / sizeof(sycl::half);
+
+    const size_t k_row = ggml_row_size(K->type, K->ne[0]);
+    const size_t v_row = ggml_row_size(V->type, V->ne[0]);
+
+    dpct::queue_ptr stream = ctx.stream();
+
+    ggml_sycl_pool_alloc<int32_t>    idx_alloc(ctx.pool(), (size_t) (n_q * n_kv_g));
+    ggml_sycl_pool_alloc<int32_t>    cnt_alloc(ctx.pool(), (size_t) n_q);
+    ggml_sycl_pool_alloc<uint8_t>    k_alloc(ctx.pool(), (size_t) (n_q * n_head_k * n_kv_g) * k_row);
+    ggml_sycl_pool_alloc<uint8_t>    v_alloc(ctx.pool(), (size_t) (n_q * n_head_k * n_kv_g) * v_row);
+    ggml_sycl_pool_alloc<sycl::half> m_alloc(ctx.pool(), (size_t) (n_q * n_kv_g));
+
+    int32_t *    d_idx  = idx_alloc.get();
+    int32_t *    d_cnt  = cnt_alloc.get();
+    uint8_t *    d_K    = k_alloc.get();
+    uint8_t *    d_V    = v_alloc.get();
+    sycl::half * d_mask = m_alloc.get();
+
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memset(d_cnt, 0, (size_t) n_q * sizeof(int32_t))));
+
+    sparse_fa_compact_mask_rows(stream, (const sycl::half *) mask->data, d_idx, d_cnt, n_kv, n_kv_g, n_q, mask_s1);
+
+    sparse_fa_gather_rows_multi(stream, (const uint8_t *) K->data, d_K, d_idx, d_cnt,
+                                k_row, K->nb[1], K->nb[2], n_kv_g, n_head_k, n_q);
+
+    sparse_fa_gather_rows_multi(stream, (const uint8_t *) V->data, d_V, d_idx, d_cnt,
+                                v_row, V->nb[1], V->nb[2], n_kv_g, V->ne[2], n_q);
+
+    sparse_fa_gather_mask_multi(stream, (const sycl::half *) mask->data, d_mask, d_idx, d_cnt, n_kv_g, n_q, mask_s1);
+
+    if (sparse_fa_debug()) {
+        std::vector<int32_t> h_cnt(n_q);
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(h_cnt.data(), d_cnt, (size_t) n_q * sizeof(int32_t))));
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));
+        int32_t mx = 0;
+        for (const int32_t c : h_cnt) {
+            mx = std::max(mx, c);
+        }
+        fprintf(stderr, "[FA-SPARSE] n_q=%lld n_kv=%lld n_kv_max=%d n_kv_g=%lld max finite=%d%s\n",
+                (long long) n_q, (long long) n_kv, ggml_get_op_params_i32(dst, 4), (long long) n_kv_g, (int) mx,
+                mx > (int32_t) n_kv_g ? "  OVERFLOW" : "");
+    }
+
+    ggml_tensor Q_g = *Q;
+    Q_g.ne[1]     = 1;
+    Q_g.ne[3]     = n_q;
+    Q_g.nb[3]     = Q->nb[1];
+    Q_g.view_src  = nullptr;
+    Q_g.view_offs = 0;
+
+    ggml_tensor K_g = *K;
+    K_g.data      = d_K;
+    K_g.ne[1]     = n_kv_g;
+    K_g.ne[3]     = n_q;
+    K_g.nb[1]     = k_row;
+    K_g.nb[2]     = (size_t) n_kv_g * k_row;
+    K_g.nb[3]     = (size_t) n_head_k * n_kv_g * k_row;
+    K_g.view_src  = nullptr;
+    K_g.view_offs = 0;
+
+    ggml_tensor V_g = *V;
+    V_g.data      = d_V;
+    V_g.ne[1]     = n_kv_g;
+    V_g.ne[3]     = n_q;
+    V_g.nb[1]     = v_row;
+    V_g.nb[2]     = (size_t) n_kv_g * v_row;
+    V_g.nb[3]     = (size_t) V->ne[2] * n_kv_g * v_row;
+    V_g.view_src  = nullptr;
+    V_g.view_offs = 0;
+
+    ggml_tensor M_g = *mask;
+    M_g.data      = d_mask;
+    M_g.ne[0]     = n_kv_g;
+    M_g.ne[1]     = 1;
+    M_g.ne[2]     = 1;
+    M_g.ne[3]     = n_q;
+    M_g.nb[1]     = (size_t) n_kv_g * sizeof(sycl::half);
+    M_g.nb[2]     = M_g.nb[1];
+    M_g.nb[3]     = M_g.nb[1];
+    M_g.view_src  = nullptr;
+    M_g.view_offs = 0;
+
+    ggml_tensor dst_g = *dst;
+    dst_g.ne[2]        = 1;
+    dst_g.ne[3]        = n_q;
+    dst_g.nb[3]        = dst->nb[2];
+    dst_g.src[0]       = &Q_g;
+    dst_g.src[1]       = &K_g;
+    dst_g.src[2]       = &V_g;
+    dst_g.src[3]       = &M_g;
+    dst_g.op_params[4] = 0;   // avoid re-entering this path
+
+    ggml_sycl_flash_attn_ext(ctx, &dst_g);
+}
+
 bool ggml_sycl_flash_attn_ext_sparse(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
     int64_t n_kv_g = 0;
     if (!sparse_fa_enabled() || !sparse_fa_applicable(dst, n_kv_g)) {
         return false;
     }
 
+    if (dst->src[0]->ne[1] > 1) {
+        ggml_sycl_flash_attn_ext_sparse_multi(ctx, dst, n_kv_g);
+        return true;
+    }
+
     ggml_tensor * K    = dst->src[1];
     ggml_tensor * V    = dst->src[2];
     ggml_tensor * mask = dst->src[3];
