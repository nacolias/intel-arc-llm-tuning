+// GGML_SYCL_OP_PROFILE=<seconds>: time each op, or each fused group, with the host clock around its
+// launch plus a queue wait, and print the totals every <seconds>. The wait stops ops from
+// overlapping, so absolute times run high; use the shares. Keys drop the "-<layer>" suffix of the
+// node name so all layers of an op add up; "+" marks a fused group, keyed by its first node.
+struct ggml_sycl_op_prof_entry {
+    double  ms = 0.0;
+    int64_t n  = 0;
+};
+static std::map<std::string, ggml_sycl_op_prof_entry> g_op_prof;
+static double g_op_prof_dev_ms[GGML_SYCL_MAX_DEVICES] = {};
+static int64_t g_op_prof_graphs = 0;
+static std::chrono::steady_clock::time_point g_op_prof_last = std::chrono::steady_clock::now();
+
+static std::string ggml_sycl_op_prof_key(const ggml_tensor * node, bool fused) {
+    std::string name = node->name;
+    const size_t p = name.find_last_of('-');
+    if (p != std::string::npos && p + 1 < name.size() &&
+        std::all_of(name.begin() + p + 1, name.end(), [](char c) { return c >= '0' && c <= '9'; })) {
+        name.resize(p);
+    }
+    return std::string(ggml_op_desc(node)) + (fused ? "+ " : " ") + name;
+}
+
+struct ggml_sycl_op_prof_scope {
+    ggml_backend_sycl_context *           ctx;
+    const ggml_tensor *                   node;
+    const int &                           i;
+    const int                             i0;
+    std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+
+    ggml_sycl_op_prof_scope(ggml_backend_sycl_context * ctx, const ggml_tensor * node, const int & i) :
+        ctx(ctx), node(node), i(i), i0(i) {}
+
+    ~ggml_sycl_op_prof_scope() {
+        try {
+            ctx->stream()->wait();
+        } catch (sycl::exception const & exc) {
+            GGML_LOG_ERROR("%s: %s\n", __func__, exc.what());
+        }
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        auto & e = g_op_prof[ggml_sycl_op_prof_key(node, i != i0)];
+        e.ms += ms;
+        e.n++;
+        g_op_prof_dev_ms[ctx->device] += ms;
+    }
+};
+
+// profiling runs only while this file exists; touch/rm it to switch without a restart
+static bool ggml_sycl_op_prof_active() {
+    static bool active = false;
+    static auto last = std::chrono::steady_clock::now() - std::chrono::seconds(1);
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last > std::chrono::milliseconds(500)) {
+        last   = now;
+        active = access("/tmp/ggml-sycl-op-profile", F_OK) == 0;
+    }
+    return active;
+}
+
+static void ggml_sycl_op_prof_maybe_print() {
+    g_op_prof_graphs++;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - g_op_prof_last < std::chrono::seconds(g_ggml_sycl_op_profile)) {
+        return;
+    }
+    g_op_prof_last = now;
+    if (g_op_prof.empty()) {
+        return;
+    }
+    std::vector<std::pair<double, std::string>> rows;
+    double total = 0.0;
+    for (const auto & kv : g_op_prof) {
+        rows.emplace_back(kv.second.ms, kv.first);
+        total += kv.second.ms;
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto & a, const auto & b) { return a.first > b.first; });
+    std::string devs;
+    for (int d = 0; d < ggml_sycl_info().device_count; ++d) {
+        devs += " d" + std::to_string(d) + "=" + std::to_string((int) g_op_prof_dev_ms[d]) + "ms";
+        g_op_prof_dev_ms[d] = 0.0;
+    }
+    GGML_LOG_WARN("[SYCL-OP-PROFILE] %.0f ms timed over %lld graph computes;%s\n", total,
+                  (long long) g_op_prof_graphs, devs.c_str());
+    const size_t n_rows = std::min<size_t>(rows.size(), 45);
+    for (size_t r = 0; r < n_rows; ++r) {
+        const auto & e = g_op_prof[rows[r].second];
+        GGML_LOG_WARN("[SYCL-OP-PROFILE] %9.1f ms %5.1f%% %8lld  %s\n", rows[r].first, 100.0 * rows[r].first / total,
+                      (long long) e.n, rows[r].second.c_str());
+    }
+    g_op_prof.clear();
+    g_op_prof_graphs = 0;
+}
